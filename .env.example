# Bombe environment template — PRD §7. Copy to `.env` and fill values for live mode.
# `.env*` are gitignored; only this `.env.example` (no values) is committed.
# Mock mode requires NONE of the [live only] vars. A missing [live only] var in
# live mode fails fast at boot with a named error.

# --- Mode ---
MODE=                              # mock|live. Default mock. Fixed at boot, no runtime switching. [mock + live]
TEST_MODE=                         # mock|stub. Test runs only. [test]

# --- Chain / wallets ([live only]) ---
RPC_URL=                           # Mantle Sepolia JSON-RPC endpoint. [live only]
CHAIN_ID=                          # 5003 (Mantle Sepolia). [live only]
DEPLOYER_KEY=                      # Private key that deploys the contracts. [live only]
AGENT_KEYS=                        # 3 comma-separated attestor private keys. [live only]
PLUGBOARD_WALLET_KEY=              # Private key for the external Plugboard attestor. [live only]
HUMAN_WALLET_KEY=                  # Private key for the human-attestor wallet. [live only]

# --- Model gateway ([live only]) ---
AI_GATEWAY_KEY=                    # API key for the AI gateway. [live only]
FALLBACK_MODEL=                    # Failover model id, e.g. meta/llama-3.3-70b. [live only]

# --- Support chatbot (apps/web /api/chat) ---
# The widget resolves its model from the first key present, in this order:
#   CHAT_API_KEY        -> NARRATOR_PRIMARY_KEY -> AI_GATEWAY_KEY
# Defaults: base URL https://api.mistral.ai/v1, model mistral-small-latest.
CHAT_API_KEY=                      # Chatbot-specific key (OpenAI-compatible). Optional override. [web]
CHAT_BASE_URL=                     # Chatbot base URL. Default https://api.mistral.ai/v1. [web]
CHAT_MODEL=                        # Chatbot model id. Default mistral-small-latest. [web]
NARRATOR_PRIMARY_KEY=              # Mistral key reused by the chatbot if CHAT_API_KEY is unset. [web]
NARRATOR_PRIMARY_BASE_URL=         # Mistral base URL. Default https://api.mistral.ai/v1. [web]
NARRATOR_PRIMARY_MODEL=            # Mistral model id. Default mistral-small-latest. [web]

# --- Storage ---
BLOB_RW_TOKEN=                     # Read/write token for blob storage (full trace bodies). [live only]
DATABASE_URL=                      # Postgres URL. Mock default: pglite file. [mock default + live]

# --- Operator / tool gateway ---
OPERATOR_KEY=                      # x-operator-key for operator endpoints. Mock default "dev-operator". [mock default + live]
TOOL_GATEWAY_KEY=                  # Bearer key for the tool gateway. Mock default "dev-gateway". [mock default + live]

# --- Runtime / limits ---
HERMES_RUNTIME_TAG=                # Pinned Hermes Agent runtime version (Plugboard). [live only]
MAX_COST_USD_PER_RUN=              # Per-run cost cap in USD. Default 0.05. [mock + live]

# --- Demo / mock timing ---
DEMO_EPOCH_SECONDS=                # Epoch length; contract deploy arg in demo/mock. Default 300. [mock]
DEMO_DISPUTE_WINDOW_SECONDS=       # Dispute window length. Default 60. [mock]
DEMO_HUMAN_LATENCY_MIN_MS=         # Min simulated human-attestor latency. Mock default 5000 (live 7200000). [mock + live]
DEMO_HUMAN_LATENCY_MAX_MS=         # Max simulated human-attestor latency. Mock default 10000 (live 21600000). [mock + live]
