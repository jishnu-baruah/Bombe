{
  "name": "bombe",
  "private": true,
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "//ci": "D7: the ci script (invoke as `pnpm run ci`) is incremental. T-102 added contracts:test to the gate (forge test). T-201 added test:unit (vitest, packages/shared). test:demo appended when M6 lands.",
    "ci": "pnpm lint && pnpm typecheck && pnpm contracts:build && pnpm contracts:test && pnpm test:unit && pnpm --filter @bombe/web typecheck",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:test:deep": "forge test --root contracts --profile deep",
    "test:contracts:deep": "pnpm contracts:test:deep",
    "test": "echo \"T-7xx: test harness not implemented yet\" && exit 1",
    "test:agent": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/test-agent.ts",
    "test:demo": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/test-demo.ts",
    "demo": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/demo.ts",
    "gen:abis": "node scripts/gen-abis.mjs",
    "deploy:testnet": "node scripts/deploy-testnet.mjs",
    "test:integration": "vitest run scripts/test/demo-integration.test.ts --config vitest.integration.config.ts",
    "progress": "node scripts/update-progress.mjs",
    "benchmark:llm": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/benchmark-llm.ts",
    "benchmark:llm:multi": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/benchmark-llm-multi.ts",
    "live:attest": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/live-attest.ts",
    "v2:attest": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/v2-attest.ts",
    "v2:streak": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/v2-streak-run.ts",
    "test:api": "node scripts/test-public-api.mjs",
    "seed-bug": "node --import ./scripts/node_modules/tsx/dist/esm/index.mjs scripts/seed-bug.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "playwright": "1.49",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
